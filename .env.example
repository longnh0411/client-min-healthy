# Copy thành .env.local (local) và điền vào Vercel dashboard (Settings → Environment
# Variables) khi deploy. Client không có backend riêng — gọi thẳng monolith.

# Base URL của monolith api-longnh-tools (Render), không có /api ở cuối.
# Trống → same-origin /api (chỉ dùng khi dev qua proxy riêng).
NEXT_PUBLIC_API_BASE_URL=

# Domain thật của app (canonical) — BẮT BUỘC cho SEO trên production:
# robots.txt, sitemap.xml, canonical + Open Graph đều dùng URL này.
# Điền trên Vercel (vd https://ngot-vua.vercel.app hoặc domain custom).
# Trống → trang vẫn chạy nhưng robots/sitemap rỗng và không có canonical.
NEXT_PUBLIC_SITE_URL=

# ---------- Firebase (Web app) ----------
# Lấy trong Firebase Console → Project settings → General → Your apps → Web app
# (phải là CÙNG Firebase project với FIREBASE_* env của api-longnh-tools,
#  vì backend verify idToken bằng project đó).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate key để nhận push nền FCM:
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
